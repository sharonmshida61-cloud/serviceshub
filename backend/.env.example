# Prisma/Neon connection string (pooled endpoint recommended for serverless)
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Secret used to sign JWTs — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"

# Origin of the deployed frontend, e.g. https://my-app.vercel.app (no trailing slash)
CORS_ORIGIN="http://localhost:5173"

# Optional overrides
# PORT=4000
# API_BASE_URL=https://my-backend.vercel.app   # used for absolute /uploads URLs; defaults to the request host
# UPLOADS_DIR=/tmp/uploads                      # media storage dir; defaults to backend/uploads (or /tmp/uploads on Vercel)

# Optional: enables "Sign in with Google". Set this to the OAuth *client ID* from
# Google Cloud (ends in .apps.googleusercontent.com) and keep it identical to
# VITE_GOOGLE_CLIENT_ID in frontend/.env.local. No client secret is needed — the
# browser gets an ID token from Google Identity Services and we verify its
# signature here. Leave unset and the Google button stays hidden.
# GOOGLE_CLIENT_ID=

# Password reset emails go through Resend (https://resend.com). Set an API key
# and a sender address verified on that account; the free "onboarding@resend.dev"
# sender only delivers to the address on your own Resend profile.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="ServiceHub <reset@yourdomain.com>"

# Where reset links point. Defaults to the first http(s) entry in CORS_ORIGIN.
# FRONTEND_URL=https://my-app.vercel.app

# Prisma/Neon connection string (pooled endpoint recommended for serverless)
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Secret used to sign JWTs — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"

# Origin of the deployed frontend, e.g. https://my-app.vercel.app (no trailing slash)
CORS_ORIGIN="http://localhost:5173"

# Optional overrides
# PORT=4000
# API_BASE_URL=https://my-backend.vercel.app   # used for absolute /uploads URLs; defaults to the request host
# UPLOADS_DIR=/tmp/uploads                      # media storage dir; defaults to backend/uploads (or /tmp/uploads on Vercel)
